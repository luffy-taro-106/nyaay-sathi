LLM_PROVIDER=ollama
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b

# OpenAI (ChatGPT-class models; best multi-turn context). Set OPENAI_API_KEY in .env:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Optional: OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: OPENAI_TIMEOUT=90

# For deployment switch:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_CHEAP_MODEL=claude-3-5-haiku-latest

# Optional: expose voice status in backend /v1/voice-config
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
